paper/*.tex
paper/*.docx
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.bbl
paper/*.blg

# LibreOffice lock files
paper/.~lock.*#
